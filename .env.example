NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Evento que este site mostra (slug em events). Padrão: getup-2026
EVENT_SLUG=getup-2026
# "true" indexa rostos das fotos sem menores (fila do worker). Padrão: false
INDEX_FACES=false

# Só dev: endpoint S3 alternativo (MinIO local). Vazio = R2.
R2_ENDPOINT=
# Só dev: hosts que podem abrir o next dev (ex.: IP da rede, para testar no celular)
DEV_ALLOWED_ORIGINS=
